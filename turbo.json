{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "public/**",
        "index.html",
        "vite.config.ts",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": ["src/**", "eslint.config.js", "package.json", "tsconfig*.json"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "inputs": ["src/**", "tsconfig*.json", "package.json"]
    },
    "test": {
      "inputs": ["src/**", "vite.config.ts", "tsconfig*.json", "package.json"]
    },
    "test:coverage": {
      "inputs": ["src/**", "vite.config.ts", "tsconfig*.json", "package.json"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "inputs": ["src/**", ".storybook/**", "package.json"],
      "outputs": ["storybook-static/**"]
    },
    "codegen": {
      "cache": false
    },
    "validate": {
      "dependsOn": ["lint", "typecheck", "test", "build"],
      "cache": false
    }
  }
}
