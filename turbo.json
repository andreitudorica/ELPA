{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NODE_ENV"]
    },
    "test:coverage": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["NODE_ENV"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["storybook-static/**"]
    },
    "codegen": {
      "cache": false
    },
    "validate": {
      "cache": false
    }
  }
}
