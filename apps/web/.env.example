# Copy this file to `.env.local` and adjust values for your machine.
#
# SECURITY: Every VITE_-prefixed variable is embedded into the public JS bundle.
# Never put secrets (API keys, tokens, passwords) in frontend environment variables.
# Identity and authentication are server-side (see ADR 0009/0010) — no identity
# variables belong here.

# Semantic deploy tier: development | test | alpha | production.
VITE_APP_ENV=development

# Base URL of the backend API (apps/api).
VITE_API_BASE_URL=/api

# API request timeout in milliseconds.
VITE_API_TIMEOUT_MS=15000

# Default UI locale on first visit (ro or en). Users can override via the
# language switcher; the preference is persisted client-side.
VITE_DEFAULT_LOCALE=ro

# Serve the app with the MSW mock backend enabled (true/false). Must be false
# in any production deployment (ADR 0016).
VITE_ENABLE_MOCKS=true

# Show TanStack Query/Router devtools (true/false). Ignored in production builds.
VITE_ENABLE_DEVTOOLS=true
