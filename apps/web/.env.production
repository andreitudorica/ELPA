# Defaults for production builds. Real deployments should provide their own
# values at build time (CI environment or hosting-platform configuration).
# ADR 0016: MSW must never be enabled in production.
VITE_APP_ENV=production
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=15000
VITE_DEFAULT_LOCALE=ro
VITE_ENABLE_MOCKS=false
VITE_ENABLE_DEVTOOLS=false
