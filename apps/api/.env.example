# apps/api environment (per ADR 0021 / 0022 scaffolding decisions).
# Copy to .env.local for local development; never commit real values.

# ── Runtime ────────────────────────────────────────────────────────────
# Required. One of: development | test | production.
NODE_ENV=development

# Required. Host and port the Fastify server binds to.
API_HOST=0.0.0.0
API_PORT=3000

# Required. Public URL prefix at which the API is served (used by
# generated OpenAPI and by CORS defaults).
API_BASE_URL=http://localhost:3000

# Required trust boundary classification. Simulated identity is refused
# when this is `public`, including public production deployments.
API_DEPLOYMENT_VISIBILITY=local

# Local/private-alpha identity. Must match an Administrator membership in
# PostgreSQL. Leave unset to make all administrative access fail closed.
API_SIMULATED_ADMINISTRATOR_EMAIL=admin@elpa.local

# ── PostgreSQL ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://elpa:elpa@localhost:5432/elpa
# DATABASE_POOL_MAX=10

# ── Logging ────────────────────────────────────────────────────────────
# Optional. One of: fatal | error | warn | info | debug | trace.
# Defaults: production → info, development → debug, test → warn.
# API_LOG_LEVEL=debug

# Request/response correlation:
# The API reads the `X-Correlation-Id` request header when present and
# echoes it back on the response. Generated as uuid v4 when absent.
# Every log line carries the value as `correlation_id`.
