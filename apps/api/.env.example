# apps/api environment (per ADR 0021 / 0022 scaffolding decisions).
# Copy to .env.local for local development; never commit real values.

# ── Runtime ────────────────────────────────────────────────────────────
# Required. One of: development | test | production.
NODE_ENV=development

# Required. Host and port the Fastify server binds to.
API_HOST=0.0.0.0
API_PORT=3000

# Required. Public URL prefix at which the API is served (used by
# generated OpenAPI and by CORS defaults).
API_BASE_URL=http://localhost:3000

# ── Logging ────────────────────────────────────────────────────────────
# Optional. One of: fatal | error | warn | info | debug | trace.
# Defaults to `info` in production, `debug` in development, `warn` in tests.
# API_LOG_LEVEL=debug
